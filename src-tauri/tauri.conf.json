{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Menu Triage",
  "version": "1.2.0",
  "identifier": "us.mario0318.context-menu-triage",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Context Menu Triage",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/context-menu-triage"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
